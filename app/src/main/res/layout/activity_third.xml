<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    xmlns:tools="http://schemas.android.com/tools"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Pertemuan3.ThirdActivity">
    <TextView
        android:id="@+id/textVerif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/archivoblack_regular"
        android:text="Selamat Datang"
        android:textSize="25sp" />
    <ImageView
        android:id="@+id/imgMobile"
        android:layout_width="130dp"
        android:layout_height="143dp"
        android:src="@drawable/mobile" />
    <EditText
        android:id="@+id/inputNoTujuan"
        android:layout_width="268dp"
        android:layout_height="wrap_content"
        android:hint="Masukkan No Tujuan"
        android:inputType="text" />
    <Button
        android:id="@+id/btnKirim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kirim" />
    <Button
        android:id="@+id/btnToFourth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#CA0E00"
        android:text="Pertemuan4" />
    <Button
        android:id="@+id/btnfi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#CA0E00"
        android:text="Pertemuan5" />
</LinearLayout>