<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Pemrograman Mobile"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 1. Button Auth -->
    <Button
        android:id="@+id/btnToAuth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF9800"
        android:padding="12dp"
        android:text="Ke Halaman Auth / Login" />

    <!-- 2. Button Pertemuan 6 -->
    <Button
        android:id="@+id/btnPertemuan6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6750A4"
        android:padding="12dp"
        android:text="Pertemuan 6" />

    <!-- 3. Button Pertemuan 9 -->
    <Button
        android:id="@+id/btnPertemuan9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6750A4"
        android:padding="12dp"
        android:text="Pertemuan 9 (Widget &amp; Layout)" />

    <!-- 4. Button Pertemuan 10 (YANG BARU DITAMBAHKAN) -->
    <Button
        android:id="@+id/btnPertemuan10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#6750A4"
        android:padding="12dp"
        android:text="Pertemuan 10 (ListView)" />

</LinearLayout>